# OpenAI-compatible chat model
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_PRIMARY_MAX_RETRIES=1
OPENAI_FALLBACK_MAX_RETRIES=1

# OpenAI-compatible embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL memory provider
DATABASE_URL=postgresql://localhost:5432/ying_companion_dev
MEMORY_POSTGRES_TABLE=companion_memories
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_MAX_RESULTS=5

# Ollama model
OLLAMA_MODEL=dzgg/gemma-4-abliterated:e2b-v2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10
