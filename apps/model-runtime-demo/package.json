{
  "name": "@ying-ai/model-runtime-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ying-ai/ai-core --filter @ying-ai/memory-postgres --filter @ying-ai/model-ollama --filter @ying-ai/story-core --filter @ying-ai/story-postgres --filter @ying-ai/tool-web-search --filter @ying-ai/tool-web-search-tavily build && next dev",
    "build": "pnpm --filter @ying-ai/ai-core --filter @ying-ai/memory-postgres --filter @ying-ai/model-ollama --filter @ying-ai/story-core --filter @ying-ai/story-postgres --filter @ying-ai/tool-web-search --filter @ying-ai/tool-web-search-tavily build && next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern next-env.d.ts",
    "verify:stream-contract": "pnpm --filter @ying-ai/ai-core build && node scripts/verify-stream-contract.mjs",
    "verify:chat-ui-adapter": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-chat-ui-adapter.ts",
    "verify:story-stream-contract": "pnpm --filter @ying-ai/story-core --filter @ying-ai/story-postgres build && node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-story-stream-contract.ts",
    "verify:story-ui-adapter": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-story-ui-adapter.ts",
    "verify:story-workbench-planner": "pnpm --filter @ying-ai/story-core --filter @ying-ai/story-postgres build && node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-story-workbench-planner.ts",
    "verify:story-workbench-data": "pnpm --filter @ying-ai/story-core --filter @ying-ai/story-postgres build && node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-story-workbench-data.ts",
    "verify:web-search-workflow": "pnpm --filter @ying-ai/ai-core --filter @ying-ai/memory-postgres --filter @ying-ai/tool-web-search --filter @ying-ai/tool-web-search-tavily build && node scripts/verify-web-search-workflow.mjs",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.226",
    "@ying-ai/ai-core": "workspace:*",
    "@ying-ai/memory-postgres": "workspace:*",
    "@ying-ai/model-ollama": "workspace:*",
    "@ying-ai/story-core": "workspace:*",
    "@ying-ai/story-postgres": "workspace:*",
    "@ying-ai/tool-web-search": "workspace:*",
    "@ying-ai/tool-web-search-tavily": "workspace:*",
    "ai": "^6.0.197",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
