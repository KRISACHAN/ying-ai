{
  "name": "ying-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "node script/app-dev.js",
    "dev:all": "turbo dev",
    "build": "node script/app-build.js",
    "build:all": "turbo build",
    "ow:install": "pnpm --filter @ying-ai/ollama-script ow:install",
    "ow:start": "pnpm --filter @ying-ai/ollama-script ow:start",
    "ow:uninstall": "pnpm --filter @ying-ai/ollama-script ow:uninstall",
    "comfy:start": "pnpm --filter @ying-ai/ollama-script comfy:start",
    "flux": "pnpm --filter @ying-ai/ollama-script flux",
    "flux:run": "pnpm --filter @ying-ai/ollama-script flux:run",
    "flux:loop": "pnpm --filter @ying-ai/ollama-script flux:loop",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@inquirer/checkbox": "^5.2.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
