{
  "name": "@ying-ai/story-core",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify:story-contract": "tsc -p tsconfig.verify.json && node .turbo/verify/scripts/verify-story-contract.js",
    "verify:story-workflow": "tsc -p tsconfig.verify.json && node .turbo/verify/scripts/verify-story-workflow.js",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ying-ai/ai-core": "workspace:*",
    "zod": "catalog:"
  }
}
