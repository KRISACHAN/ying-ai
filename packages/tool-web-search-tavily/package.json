{
  "name": "@ying-ai/tool-web-search-tavily",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --test scripts/search-strategy.test.mjs",
    "verify:web-search-contract": "pnpm build && node scripts/verify-web-search-contract.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ying-ai/tool-web-search": "workspace:*"
  }
}
